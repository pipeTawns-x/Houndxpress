# Respaldo manual: GGA_PROVIDER=opencode:opencode/big-pickle
# nemotron-3-ultra-free dejó de existir (2026-10-27); se alinea con el proveedor de backend y practicas-ebac.
PROVIDER="opencode:nvidia/minimaxai/minimax-m3.1-flash"
RULES_FILE="AGENTS.md"
STRICT_MODE="true"
TIMEOUT="300"
FILE_PATTERNS="*.py,*.ts,*.tsx,*.js,*.jsx,*.scss"
EXCLUDE_PATTERNS="*.test.*,*.spec.*,*/tests/*,test_*.py,*_test.py,tests.py,*.d.ts,backend/*/migrations/*"
