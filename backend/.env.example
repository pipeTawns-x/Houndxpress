# Optional. Copy to backend/.env to override the defaults.
# Nothing here is needed for local development (DJANGO_DEBUG=true).
DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Comma-separated. Required when DJANGO_DEBUG=false.
# Defaults to localhost,127.0.0.1,[::1] in development.
DJANGO_ALLOWED_HOSTS=
